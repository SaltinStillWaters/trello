# Used for checking if the .env is configured properly
TEST_NUMBER=22
TEST_STRING="THIS IS FROM .ENV!!"

# --- DATABASE CONFIGURATION ---
# These settings must match your local setup or Docker container config.
DB_TYPE="postgres"
DB_HOST="127.0.0.1"
DB_PORT="5435"
DB_USERNAME="admin"
DB_PASSWORD="secretpassword"            
DB_DATABASE="trello_pejana"

DB_SYNCHRONIZE="true"



NODE_ENV = development

PORT = 3000
DOMAIN = domain.com

COOKIE_SECRET = secret

JWT_SECRET = secret
JWT_EXPIRY = 500000

REFRESH_EXPIRY = 50000000