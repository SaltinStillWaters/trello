# -------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (TEMPLATE)
# Copy this file to '.env' and fill in your actual secrets.
# Do NOT commit the '.env' file to version control.
# -------------------------------------------------------------------------

# --- TESTING CONFIGURATION ---
# Used for checking if the .env is configured properly
TEST_NUMBER=22
TEST_STRING="THIS IS FROM .ENV!!"

# --- DATABASE CONFIGURATION ---
# These settings must match your local setup or Docker container config.
DB_TYPE="postgres"
DB_HOST="127.0.0.1"
DB_PORT="5435"
DB_USERNAME="admin"
DB_PASSWORD="secretpassword"            # Leave blank in example; force the user to set it
DB_DATABASE="trello_pejana"

# DB_SYNCHRONIZE: Set to 'true' for dev to auto-sync entities with DB.
# WARNING: Do not use 'true' in production as it may cause data loss.
DB_SYNCHRONIZE="true"

# --- DOCKER CONFIGURATION (Optional) ---
# Add Docker-specific prefixes here if needed in the future
# DOCKER_CONTAINER_NAME=backend_api