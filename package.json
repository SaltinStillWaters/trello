{
  "name": "sudocodes_pos",
  "private": true,
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^10.32.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:fe": "pnpm --filter frontend run dev",
    "dev:be": "pnpm --filter backend run dev",
    "add:be": "pnpm --filter backend add",
    "add:fe": "pnpm --filter frontend add",
    "seed": "pnpm --filter backend run seed",
    "build": "pnpm -r build",
    "db:tables": "bash -c 'if [ -z \"$1\" ]; then docker exec -it sudocodes_pos_db psql -U admin -d sudocodes_pos -c \"\\dt\"; else docker exec -it sudocodes_pos_db psql -U admin -d sudocodes_pos -c \"SELECT * FROM $1;\"; fi' --"
  }
}
